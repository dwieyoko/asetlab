# ========================================================
# Frontend Vite Configuration
# ========================================================
# URL Backend API (di production DomaiNesia cukup /api)
VITE_API_BASE_URL=/api

# ========================================================
# Backend PHP Configuration
# ========================================================
# Untuk backend PHP di DomaiNesia / lokal, copy file:
#   api/secrets.example.php  -->  api/secrets.php
# lalu isi kredensial MySQL, JWT_SECRET, dan Payment Gateway di sana.
# File api/secrets.php di-ignore oleh Git agar rahasia tidak bocor.
